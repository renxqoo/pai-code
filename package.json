{
  "name": "x3code",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/relay-protocol"
  ],
  "scripts": {
    "lint": "oxlint --type-aware .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "build": "bun run --filter '@x3code/electron' build && bun run --filter '@x3code/mobile' build:web",
    "test": "bun run --filter '@x3code/mobile' test",
    "ci": "bun run lint && bun run typecheck && bun run build && bun run test"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.81.0",
    "@types/node": "26.4.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "buffer": "^6.0.3",
    "expo-secure-store": "^57.0.4"
  }
}