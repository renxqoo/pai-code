{
  "expo": {
    "name": "X3code",
    "slug": "x3code",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "x3code",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.x3code.app"
    },
    "android": {
      "package": "com.x3code.app",
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router", "expo-document-picker", "expo-image-picker"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
